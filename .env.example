# ===== 应用配置 =====
APP_NAME=mimo
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_PORT=8100

# ===== 数据库 =====
DATABASE_URL=postgresql+asyncpg://mimo:mimo123@localhost:5432/mimo
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_URL=redis://localhost:6479/0

# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9192

# ===== Elasticsearch =====
ELASTICSEARCH_URL=http://localhost:9320

# ===== ClickHouse =====
CLICKHOUSE_URL=http://localhost:8223

# ===== MQTT (EMQX) =====
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6479/1
CELERY_RESULT_BACKEND=redis://localhost:6479/2

# ===== JWT =====
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== AI 评测 =====
AI_MODEL_PATH=/models
AI_GPU_ENABLED=false

# ===== 测试设备 =====
DEVICE_MAX_CONCURRENT=100
DEVICE_RECOVERY_TIMEOUT=300

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:8100/api/v1
VITE_WS_URL=ws://localhost:8100/ws
